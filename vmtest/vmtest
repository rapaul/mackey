#!/usr/bin/env bash
#
# vmtest — reproducible ephemeral VMs for mackey's integration tests.
#
# Runs entirely rootless: cloud-init images booted with qemu (KVM) using
# user-mode networking + SSH port-forward. No libvirt, no sudo on the host.
# /dev/kvm must be accessible (it is world-rw on the dev box).
#
# Layout (under $VMTEST_DATA, default ~/.local/share/mackey-vmtest):
#   images/<distro>.qcow2        pristine base cloud image (read-only)
#   ssh/id_ed25519[.pub]         harness keypair injected via cloud-init
#   run/<distro>/provisioned.qcow2  golden image: base + GNOME + tester
#   run/<distro>/disk.qcow2      ephemeral overlay on golden; tests run here
#   run/<distro>/{seed.iso,qemu.pid,serial.log}
#
# A two-layer overlay chain (base <- provisioned <- ephemeral) makes
# `snapshot reset` an O(1) rollback: drop the ephemeral overlay, recreate it.
#
# Usage:
#   vmtest <distro> up                 boot (provisioning the golden image once)
#   vmtest <distro> install <pkg>      copy + install a .deb/.rpm
#   vmtest <distro> run "<cmd>"        run a command as tester (exit code passes through)
#   vmtest <distro> journal <unit>     dump a systemd unit's journal
#   vmtest <distro> snapshot reset     roll back to the golden image
#   vmtest <distro> down               power off the VM
#   vmtest <distro> destroy            power off and delete all per-distro state
#   vmtest <distro> status             show running / ssh-reachable state
#   vmtest <distro> fetch              download the base image if missing
#   vmtest selftest                    validate arg parsing + host tooling (no VM)
#
#   <distro> is one of: ubuntu (ubuntu24), fedora (fedora43/fedora40)
set -euo pipefail

VMTEST_DATA="${VMTEST_DATA:-$HOME/.local/share/mackey-vmtest}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLOUD_INIT_DIR="$SCRIPT_DIR/cloud-init"
IMAGES_DIR="$VMTEST_DATA/images"
SSH_DIR="$VMTEST_DATA/ssh"
SSH_KEY="$SSH_DIR/id_ed25519"

# Generous timeouts: a first-boot GNOME install pulls hundreds of packages.
SSH_WAIT_SECS=240
CLOUDINIT_WAIT_SECS=1800
DISK_SIZE=20G
VM_MEM=4096
VM_CPUS=2

log()  { printf '\033[1;34m[vmtest]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[vmtest]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[vmtest]\033[0m %s\n' "$*" >&2; exit 1; }

# --- distro config ----------------------------------------------------------
# Sets globals: D_NAME D_IMAGE D_URL D_PORT D_PKG D_USERDATA
distro_config() {
    case "$1" in
        ubuntu|ubuntu24)
            D_NAME=ubuntu
            D_PORT=2224
            D_PKG=apt
            D_URL="https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img"
            ;;
        fedora|fedora43|fedora40)
            D_NAME=fedora
            D_PORT=2243
            D_PKG=dnf
            D_URL="https://download.fedoraproject.org/pub/fedora/linux/releases/43/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-43-1.6.x86_64.qcow2"
            ;;
        *) die "unknown distro '$1' (want: ubuntu|fedora)" ;;
    esac
    D_IMAGE="$IMAGES_DIR/$D_NAME.qcow2"
    D_USERDATA="$CLOUD_INIT_DIR/user-data.$D_NAME"
    RUN="$VMTEST_DATA/run/$D_NAME"
}

# --- ssh helpers ------------------------------------------------------------
ensure_sshkey() {
    [ -f "$SSH_KEY" ] && return 0
    mkdir -p "$SSH_DIR"
    ssh-keygen -t ed25519 -N '' -f "$SSH_KEY" -C mackey-vmtest >/dev/null
    log "generated harness ssh key"
}

# Common options shared by ssh/scp. Port differs by flag (-p vs -P), so it is
# added by each wrapper rather than here.
ssh_common() {
    echo -n "-i $SSH_KEY \
-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
-o ConnectTimeout=5 -o LogLevel=ERROR -o BatchMode=yes"
}

vssh() { # shellcheck disable=SC2046
    ssh $(ssh_common) -p "$D_PORT" tester@127.0.0.1 "$@"
}

vscp() { # shellcheck disable=SC2046
    scp $(ssh_common) -P "$D_PORT" "$1" tester@127.0.0.1:"$2"
}

wait_ssh() {
    log "waiting for ssh on :$D_PORT (up to ${SSH_WAIT_SECS}s)"
    local deadline=$(( SECONDS + SSH_WAIT_SECS ))
    while (( SECONDS < deadline )); do
        if vssh true 2>/dev/null; then log "ssh up"; return 0; fi
        sleep 3
    done
    die "ssh did not come up within ${SSH_WAIT_SECS}s (see $RUN/serial.log)"
}

# --- qemu lifecycle ---------------------------------------------------------
vm_pid() { [ -f "$RUN/qemu.pid" ] && cat "$RUN/qemu.pid" 2>/dev/null || true; }
vm_running() { local p; p="$(vm_pid)"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

boot_qemu() { # $1=disk  $2=optional seed.iso
    local disk="$1" seed="${2:-}" seedarg=()
    [ -n "$seed" ] && seedarg=(-cdrom "$seed")
    qemu-system-x86_64 \
        -name "mackey-$D_NAME" \
        -machine q35,accel=kvm -cpu host -smp "$VM_CPUS" -m "$VM_MEM" \
        -drive file="$disk",if=virtio,format=qcow2 \
        "${seedarg[@]}" \
        -vga virtio -display none \
        -device qemu-xhci,id=xhci \
        -netdev user,id=net0,hostfwd=tcp:127.0.0.1:"$D_PORT"-:22 \
        -device virtio-net-pci,netdev=net0 \
        -qmp "unix:$RUN/qmp.sock,server=on,wait=off" \
        -serial file:"$RUN/serial.log" \
        -pidfile "$RUN/qemu.pid" -daemonize
}

# Send one QMP command (JSON) to the running VM and print the JSON reply.
# Handles the capabilities handshake and skips async events.
qmp_send() {
    [ -S "$RUN/qmp.sock" ] || die "qmp socket missing (is $D_NAME up?)"
    python3 - "$RUN/qmp.sock" "$1" <<'PY'
import json, socket, sys
sock_path, cmd = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX); s.connect(sock_path)
f = s.makefile("rw")
f.readline()  # QMP greeting
def rpc(obj):
    f.write(json.dumps(obj) + "\n"); f.flush()
    while True:
        line = f.readline()
        if not line:
            return None
        msg = json.loads(line)
        if "event" in msg:   # async event, not our reply
            continue
        return msg
rpc({"execute": "qmp_capabilities"})
print(json.dumps(rpc(json.loads(cmd))))
PY
}

poweroff_vm() {
    vm_running || return 0
    log "powering off $D_NAME"
    vssh "sudo poweroff" 2>/dev/null || true
    local deadline=$(( SECONDS + 60 ))
    while vm_running && (( SECONDS < deadline )); do sleep 2; done
    if vm_running; then warn "force-killing qemu"; kill "$(vm_pid)" 2>/dev/null || true; fi
    rm -f "$RUN/qemu.pid" "$RUN/qmp.sock"
}

# --- provisioning -----------------------------------------------------------
render_seed() {
    mkdir -p "$RUN"
    local pubkey; pubkey="$(cat "$SSH_KEY.pub")"
    sed "s|__SSH_PUBKEY__|$pubkey|" "$D_USERDATA" > "$RUN/user-data"
    sed "s|__DISTRO__|$D_NAME|" "$CLOUD_INIT_DIR/meta-data" > "$RUN/meta-data"
    genisoimage -quiet -output "$RUN/seed.iso" -volid cidata -joliet -rock \
        "$RUN/user-data" "$RUN/meta-data"
}

provision() {
    [ -f "$RUN/provisioned.qcow2" ] && return 0
    [ -f "$D_IMAGE" ] || die "base image missing: $D_IMAGE (run: vmtest $D_NAME fetch)"
    ensure_sshkey
    mkdir -p "$RUN"
    log "provisioning golden image for $D_NAME (installs GNOME; this is slow)"
    qemu-img create -q -f qcow2 -F qcow2 -b "$D_IMAGE" "$RUN/provisioned.qcow2" "$DISK_SIZE"
    render_seed
    boot_qemu "$RUN/provisioned.qcow2" "$RUN/seed.iso"
    wait_ssh
    log "running cloud-init to completion (up to ${CLOUDINIT_WAIT_SECS}s)"
    if ! timeout "$CLOUDINIT_WAIT_SECS" ssh $(ssh_common) -p "$D_PORT" tester@127.0.0.1 \
            "sudo cloud-init status --wait"; then
        poweroff_vm; die "cloud-init did not finish (see $RUN/serial.log)"
    fi
    # Verify GNOME landed: shell present, a display manager wired in, and the
    # system boots graphical. (gdm is reported 'static'/'alias' rather than
    # 'enabled', so check the display-manager unit + default target instead.)
    vssh 'command -v gnome-shell >/dev/null \
            && systemctl cat display-manager.service >/dev/null 2>&1 \
            && [ "$(systemctl get-default)" = graphical.target ]' \
        || { poweroff_vm; die "GNOME/gdm not present after provisioning"; }
    log "GNOME provisioned; sealing golden image"
    poweroff_vm
    rm -f "$RUN/seed.iso" "$RUN/user-data" "$RUN/meta-data"
}

ensure_ephemeral() {
    [ -f "$RUN/disk.qcow2" ] && return 0
    qemu-img create -q -f qcow2 -F qcow2 -b "$RUN/provisioned.qcow2" "$RUN/disk.qcow2"
}

up() {
    # Quiet when already up so a later `run` captures only the guest's output.
    vm_running && return 0
    provision
    ensure_ephemeral
    log "booting $D_NAME"
    boot_qemu "$RUN/disk.qcow2"
    wait_ssh
}

# --- subcommands ------------------------------------------------------------
cmd_fetch() {
    mkdir -p "$IMAGES_DIR"
    [ -f "$D_IMAGE" ] && { log "$D_NAME base image already present"; return 0; }
    log "downloading $D_NAME base image"
    wget -q --show-progress -O "$D_IMAGE.part" "$D_URL"
    mv "$D_IMAGE.part" "$D_IMAGE"
}

cmd_install() {
    local pkg="$1"; [ -f "$pkg" ] || die "package not found: $pkg"
    up
    local base; base="$(basename "$pkg")"
    log "installing $base on $D_NAME"
    vscp "$pkg" "/tmp/$base"
    case "$D_PKG" in
        apt) vssh "sudo apt-get install -y /tmp/$base" ;;
        dnf) vssh "sudo dnf install -y /tmp/$base" ;;
    esac
}

cmd_run()     { up; vssh "$1"; }
cmd_journal() { up; vssh "sudo journalctl -u '$1' --no-pager -n 200"; }

cmd_snapshot() {
    [ "${1:-}" = reset ] || die "usage: vmtest <distro> snapshot reset"
    [ -f "$RUN/provisioned.qcow2" ] || die "no golden image to reset to (provision first)"
    poweroff_vm
    rm -f "$RUN/disk.qcow2"
    ensure_ephemeral
    log "$D_NAME reset to golden image"
}

cmd_status() {
    if vm_running; then
        local reach=no; vssh true 2>/dev/null && reach=yes
        echo "$D_NAME: running (pid $(vm_pid)), ssh-reachable=$reach, port=$D_PORT"
    else
        echo "$D_NAME: stopped"
    fi
}

cmd_destroy() { poweroff_vm; rm -rf "$RUN"; log "$D_NAME state removed"; }

# --- selftest (no VM) -------------------------------------------------------
selftest() {
    local fail=0
    for t in qemu-system-x86_64 qemu-img genisoimage ssh ssh-keygen scp wget; do
        command -v "$t" >/dev/null || { warn "missing tool: $t"; fail=1; }
    done
    [ -r /dev/kvm ] && [ -w /dev/kvm ] || { warn "/dev/kvm not accessible"; fail=1; }
    distro_config ubuntu; [ "$D_NAME" = ubuntu ] && [ "$D_PORT" = 2224 ] || { warn "ubuntu cfg"; fail=1; }
    distro_config fedora43; [ "$D_NAME" = fedora ] && [ "$D_PKG" = dnf ] || { warn "fedora cfg"; fail=1; }
    if ( distro_config bogus ) >/dev/null 2>&1; then warn "bad distro accepted"; fail=1; fi
    [ -f "$CLOUD_INIT_DIR/user-data.ubuntu" ] && [ -f "$CLOUD_INIT_DIR/user-data.fedora" ] \
        && [ -f "$CLOUD_INIT_DIR/meta-data" ] || { warn "cloud-init templates missing"; fail=1; }
    [ "$fail" = 0 ] && { log "selftest OK"; return 0; } || die "selftest FAILED"
}

# --- dispatch ---------------------------------------------------------------
usage() { sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
    [ $# -ge 1 ] || { usage; exit 2; }
    if [ "$1" = selftest ]; then selftest; return; fi
    [ $# -ge 2 ] || { usage; exit 2; }
    local distro="$1" sub="$2"; shift 2
    distro_config "$distro"
    case "$sub" in
        fetch)    cmd_fetch ;;
        up)       up ;;
        install)  [ $# -ge 1 ] || die "usage: vmtest $distro install <pkg>"; cmd_install "$1" ;;
        run)      [ $# -ge 1 ] || die "usage: vmtest $distro run \"<cmd>\""; cmd_run "$1" ;;
        journal)  [ $# -ge 1 ] || die "usage: vmtest $distro journal <unit>"; cmd_journal "$1" ;;
        qmp)      [ $# -ge 1 ] || die "usage: vmtest $distro qmp '<json>'"; qmp_send "$1" ;;
        snapshot) cmd_snapshot "${1:-}" ;;
        down)     poweroff_vm ;;
        destroy)  cmd_destroy ;;
        status)   cmd_status ;;
        *)        usage; exit 2 ;;
    esac
}

main "$@"
