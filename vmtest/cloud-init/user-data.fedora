#cloud-config
# Fedora (latest) provisioning for the mackey vmtest harness.
# A normal sudo-capable desktop user `tester` (mirrors a real GNOME user); the
# cross-cutting invariant checks that installing mackey never changes its groups.
hostname: mackey-fedora
users:
  - name: tester
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: tester
    ssh_authorized_keys:
      - __SSH_PUBKEY__
ssh_pwauth: true
packages:
  - gnome-shell
  - gdm
  - gnome-session-wayland-session
  - nautilus
runcmd:
  - [ bash, -c, "printf '[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=tester\nWaylandEnable=true\n' > /etc/gdm/custom.conf" ]
  - [ systemctl, set-default, graphical.target ]
  - [ systemctl, enable, gdm ]
