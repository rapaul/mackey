# mackey device access.
#
# Grant the unprivileged `mackey` group read/write on the uinput node (where the
# daemon emits synthetic events) and on every keyboard input event device (which
# the daemon grabs). Group ownership + 0660 is the whole privilege model: mackey
# never needs root and no login user is added to any group.

KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="mackey", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", GROUP="mackey", MODE="0660"

# Tag the daemon's virtual keyboard as an internal keyboard. The daemon grabs
# (EVIOCGRAB) the real keyboard, so libinput never sees its keystrokes and would
# never pair a touchpad with an internal keyboard — silently breaking
# disable-while-typing (DWT). The synthetic keystrokes come out of this virtual
# device instead, so it must be the one libinput treats as internal.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="mackey virtual keyboard", ENV{ID_INPUT_KEYBOARD_INTEGRATION}="internal"
